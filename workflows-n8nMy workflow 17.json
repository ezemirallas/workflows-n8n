    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst excluir = \"osep.notificaciones@osep.mendoza.gov.ar\";\nconst asunto = item.asunto ?? \"\";\nconst cuerpo = item.cuerpo ?? \"\";\n\nlet correo_final = null;\nlet tipo = null;\n\n// Determinar remitente\nif (asunto.toLowerCase().includes(\"failure\") || asunto.toLowerCase().includes(\"undelivered\")) {\n  const matches = cuerpo.match(/<([^>]+@[^>]+)>/g) ?? [];\n  const emails = matches\n    .map(m => m.replace(/[<>]/g, '').trim())\n    .filter(e => e.toLowerCase() !== excluir.toLowerCase());\n  correo_final = emails[0] ?? null;\n  tipo = \"rebote\";\n} else {\n  const de = item.de ?? \"\";\n  const match = de.match(/<([^>]+)>/) ?? [];\n  correo_final = match[1] ?? de.trim();\n  if (correo_final.toLowerCase() === excluir.toLowerCase()) correo_final = null;\n  tipo = \"respuesta\";\n}\n\n// Derivación aleatoria a uno de las cuentas\nconst cuentas = [\n  \"osep.notificaciones1@gmail.com\",\n  \"osep.notificaciones2@gmail.com\"\n];\nconst cuenta_destino = cuentas[Math.floor(Math.random() * 2)];\n\nreturn [{ json: { correo_final, tipo, asunto, cuenta_destino } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        -16
      ],
