    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  let texto = item.json.output || '';\n  \n  // Eliminar prefijos comunes que el LLM a veces agrega en inglés\n  texto = texto.replace(/^(Assistant:|Response:|AI:)/i, '').trim();\n  \n  // Limpiar caracteres que rompen el JSON\n  const limpio = texto\n    .replace(/\\n/g, ' ')\n    .replace(/\\r/g, ' ')\n    .replace(/\\t/g, ' ')\n    .replace(/\"/g, \"'\")\n    .replace(/\\\\/g, '')\n    .trim();\n  \n  return {\n    json: {\n      ...item.json,\n      output: limpio\n    }\n  };\n});"
      },
