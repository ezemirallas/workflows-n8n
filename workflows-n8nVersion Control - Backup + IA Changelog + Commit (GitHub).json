    {
      "parameters": {
        "jsCode": "// Compara updatedAt actual vs. el último estado commiteado en GitHub\nconst allWorkflows = $('Get All Workflows (n8n)').first().json.data || $('Get All Workflows (n8n)').first().json;\nconst stateResp = $input.first().json;\n\nlet previousState = {};\nif (stateResp && stateResp.content) {\n  try {\n    previousState = JSON.parse(Buffer.from(stateResp.content, 'base64').toString('utf-8'));\n  } catch (e) { previousState = {}; }\n}\n\nconst changed = [];\nconst newState = {};\n\nfor (const wf of allWorkflows) {\n  newState[wf.id] = wf.updatedAt;\n  const prevUpdatedAt = previousState[wf.id];\n  if (!prevUpdatedAt || prevUpdatedAt !== wf.updatedAt) {\n    changed.push({\n      id: wf.id,\n      name: wf.name,\n      updatedAt: wf.updatedAt,\n      previousUpdatedAt: prevUpdatedAt || null\n    });\n  }\n}\n\nreturn {\n  json: {\n    hasChanges: changed.length > 0,\n    changed,\n    newState,\n    stateFileSha: stateResp && stateResp.sha ? stateResp.sha : null\n  }\n};"
      },
      "name": "Detect Changes",
