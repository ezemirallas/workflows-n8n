    {
      "parameters": {
        "jsCode": "const backup = $('Backup: traer workflow completo').first().json;\nconst prevVersion = $('Traer version anterior (GitHub)').first().json;\nconst aiResp = $input.first().json;\n\nlet commitMessage = 'deploy: actualizacion de workflow';\ntry {\n  commitMessage = aiResp.content[0].text.trim();\n} catch (e) {}\n\nconst timestamp = new Date().toISOString().replace(/[:.]/g, '-');\nconst content = Buffer.from(JSON.stringify(backup, null, 2)).toString('base64');\n\nreturn {\n  json: {\n    workflowId: backup.id,\n    commitMessage,\n    timestamp,\n    content,\n    previousSha: prevVersion && prevVersion.sha ? prevVersion.sha : null\n  }\n};"
      },
