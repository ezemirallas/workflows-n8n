        "jsCode": "const now = new Date();\nconst argentinaOffsetMs = -3 * 60 * 60 * 1000;\nconst argentinaTime = new Date(now.getTime() + argentinaOffsetMs);\n\n// Formatear manualmente en ISO sin zona horaria\nconst isoLocal = argentinaTime.toISOString().replace(/Z$/, '');\n\nreturn [\n  {\n    json: {\n      fecha_sin_timezone: isoLocal,\n    }\n  }\n];"
