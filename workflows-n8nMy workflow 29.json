    {
      "parameters": {
        "jsCode": "// Verificar si la respuesta en cache sigue siendo válida\nconst cacheEntry = $input.all()[0].json;\nconst cacheAge = new Date() - new Date(cacheEntry.created_at);\nconst maxAge = 24 * 60 * 60 * 1000; // 24 horas en ms\n\n// Verificar relevancia usando similarity score\nconst relevanceThreshold = 0.85;\nconst isRelevant = cacheEntry.similarity_score >= relevanceThreshold;\nconst isFresh = cacheAge < maxAge;\n\nif (isRelevant && isFresh) {\n  return {\n    use_cache: true,\n    response: cacheEntry.response,\n    cache_metadata: {\n      age_hours: Math.round(cacheAge / (1000 * 60 * 60)),\n      similarity: cacheEntry.similarity_score,\n      query_count: cacheEntry.query_count + 1\n    }\n  };\n} else {\n  return {\n    use_cache: false,\n    reason: !isRelevant ? 'low_relevance' : 'expired'\n  };\n}\n"
      },
