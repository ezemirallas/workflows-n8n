    {
      "parameters": {
        "jsCode": "// Obtener la respuesta del modelo\nconst response = $json.response.text ?? $json.response;\n\n// Recuperar el query original desde el nodo donde se definió\nconst currentQuery = $node[\"Process Query\"].json[\"original_query\"];\n\n// Función simple de similitud (puede mejorarse con embeddings)\nfunction calculateSimilarity(query1, query2) {\n  const words1 = query1.toLowerCase().split(' ');\n  const words2 = query2.toLowerCase().split(' ');\n  \n  const intersection = words1.filter(word => words2.includes(word));\n  const union = [...new Set([...words1, ...words2])];\n  \n  return intersection.length / union.length;\n}\n\n// Generar hash semántico\nfunction generateSemanticHash(query) {\n  const normalized = query.toLowerCase()\n    .replace(/[¿?¡!]/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  \n  const words = normalized.split(' ');\n  const keyWords = words.filter(word => word.length > 3);\n  \n  return keyWords.sort().join('_');\n}\n\nconst semanticHash = generateSemanticHash(currentQuery);\n\nreturn {\n  query_hash: semanticHash,\n  original_query: currentQuery,\n  response,\n  similarity_score: 1.0, // Score máximo porque es nueva\n  created_at: new Date().toISOString(),\n  query_count: 1,\n  last_used: new Date().toISOString()\n};\n"
      },
