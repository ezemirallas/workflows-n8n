      "parameters": {
        "jsCode": "const str = $input.item.json.destinatarios;\nconst excluir = \"osep.notificaciones@osep.mendoza.gov.ar\";\n\n// Convertimos a array, limpiamos espacios y filtramos\nconst resultado = str.split(',')\n  .map(email => email.trim())\n  .filter(email => email.toLowerCase() !== excluir.toLowerCase());\n\nreturn {\n  correo_final: resultado[0] // Retorna el primero que no sea el excluido\n};"
