        "text": "=## Nombre del documento:\n{{ $('Loop Over Items').item.json.name }}\n\n## Contenido del Documento:\n{{ \n  (() => {\n    const text = String($('Contenido del Documento').item.json.contenido\n?? \"\");\n    return text.length >30000\n      ? text.slice(0,30000)\n      : text;\n  })()\n}}\n",
