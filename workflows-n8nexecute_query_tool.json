      {
        "parameters": {
          "jsCode": "//Inicializar un objeto para almacenar el resultado combinado\nlet combinedObject = {};\n\n//Iterar a través de todos los elementos de entrada\nlet index = 0;\nitems.forEach(item =>{\n  try {\n    // Parsear el string JSON de cada respuesta a un objeto\n    const parsedData = JSON.parse(item.json.response);\n    // Para cada propiedad en el objeto parseado\n    Object.keys(parsedData).forEach(key => {\n      // Crear una clave unica usando el indice para evitar colisiones\n      const uniqueKey = \"${key}_${index}\";\n      combinedObject[uniqueKey]= parsedData[key]; \n    });\n  index++;\n} catch (error) {\n    console.log(\"Error al parsear JSON: ${error.message}\");\n}\n});\n\n// Crear un unico item con el objeto resultante\nreturn [{\n  json: {\n    combinedData: combinedObject\n  }\n}];"
        },
