      "id": "493a9e60-d32b-4def-856d-b0da7ef2f6ce",
      "name": "Webhook - Recibir Audio",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "whisper-stt-webhook",
      "notes": "Endpoint: POST /webhook/stt\nEnviar audio como multipart/form-data con campo 'file'"
    },
    {
      "parameters": {
        "jsCode": "// Verificar que llegó un archivo de audio\nconst items = $input.all();\n\nfor (const item of items) {\n  const binaryData = item.binary;\n  \n  if (!binaryData || Object.keys(binaryData).length === 0) {\n    throw new Error('No se recibió ningún archivo de audio. Enviá el audio como multipart/form-data con el campo \"file\"');\n  }\n  \n  // Obtener el primer campo binario disponible\n  const fieldName = Object.keys(binaryData)[0];\n  const file = binaryData[fieldName];\n  \n  // Validar tipo de archivo\n  const allowedTypes = ['audio/mpeg', 'audio/mp3', 'audio/wav', 'audio/ogg', 'audio/webm', 'audio/flac', 'audio/mp4', 'video/mp4'];\n  const allowedExtensions = ['mp3', 'wav', 'ogg', 'webm', 'flac', 'm4a', 'mp4', 'mpeg'];\n  \n  const fileExt = file.fileName ? file.fileName.split('.').pop().toLowerCase() : '';\n  \n  if (!allowedExtensions.includes(fileExt)) {\n    throw new Error(`Formato no soportado: .${fileExt}. Formatos válidos: ${allowedExtensions.join(', ')}`);\n  }\n  \n  item.json.audioFieldName = fieldName;\n  item.json.fileName = file.fileName || 'audio.mp3';\n  item.json.mimeType = file.mimeType || 'audio/mpeg';\n}\n\nreturn items;"
      },
      "id": "b077f5ee-6086-4d6d-a601-2939b525144b",
      "name": "Validar Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
