    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const tel1 = $node[\"paso\"].json[\"TELEFONO\"] || '';\n  const tel2 = $node[\"paso\"].json[\"TELEFONO 2\"] || '';\n\n  // Prioriza TELÉFONO 2 si existe, si no usa TELÉFONO\n  let raw = tel2.trim() !== '' ? tel2 : tel1;\n\n  // Elimina espacios, guiones, paréntesis\n  raw = raw.replace(/[^\\d]/g, '');\n\n  // Elimina un 15 al inicio si lo tiene\n  if (raw.startsWith('15')) {\n    raw = raw.substring(2);\n  }\n\n  // Si comienza con 0, se lo quitamos\n  if (raw.startsWith('0')) {\n    raw = raw.substring(1);\n  }\n\n  // Si tiene solo 7 dígitos, le agregamos código de área 261\n  if (raw.length === 7) {\n    raw = '261' + raw;\n  }\n\n  // Aseguramos que empiece con 549 (código internacional +9 + celular)\n  if (!raw.startsWith('549')) {\n    raw = '549' + raw;\n  }\n\n  return {\n    json: {\n      telefono_estandarizado: raw\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
