      {
        "parameters": {
          "jsCode": "const alerts = $input.first().json.alerts || [];\nconst messages = [];\n\nfor (const alert of alerts) {\n  const status = alert.status === 'firing' ? '🔴 ALERTA' : '✅ RESUELTO';\n  const severity = alert.labels?.severity?.toUpperCase() || 'N/A';\n  const name = alert.labels?.alertname || 'Sin nombre';\n  const summary = alert.annotations?.summary || 'Sin descripción';\n  const description = alert.annotations?.description || '';\n  const since = alert.startsAt ? new Date(alert.startsAt).toLocaleString('es-AR', {timeZone: 'America/Argentina/Mendoza'}) : '';\n\n  let msg = `${status} [${severity}]\\n`;\n  msg += `📛 *${name}*\\n`;\n  msg += `📝 ${summary}\\n`;\n  if (description) msg += `🔍 ${description}\\n`;\n  if (since) msg += `🕐 Desde: ${since}`;\n\n  messages.push({ json: { text: msg } });\n}\n\nreturn messages.length > 0 ? messages : [{ json: { text: '📭 Sin alertas en el payload' } }];"
        },
        "name": "Formatear mensaje",
